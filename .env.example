# 复制为 .env 后填写，勿提交 .env
# 代理（可选，Upwork 一般可不配）
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=http://user:pass@host:port

# Telegram 推送（必填则推送）
TELEGRAM_BOT_TOKEN=你的Bot_Token
TELEGRAM_CHAT_ID=你的Chat_ID

# Apify（可选，用于 Upwork 抓取，绕过 Cloudflare）
# 在 https://console.apify.com/account/integrations 获取
# APIFY_API_TOKEN=apify_api_xxxx

# 数据与日志路径（可选，默认见 run.py）
# DATA_DIR=./data
# LOG_LEVEL=INFO

# 每日推送时间（可选，默认 09:00）
# TELEGRAM_PUSH_HOUR=9
# TELEGRAM_PUSH_MINUTE=0
# TZ=Asia/Shanghai

# 火山引擎 Doubao 摘要（可选，v2：将职位描述总结为 50 字以内中文再推送到 Telegram）
# 在火山引擎控制台创建 API Key，模型名称见方舟模型广场
# VOLCANO_API_KEY=你的API_Key
# VOLCANO_MODEL=deepseek-v3-2-251201

# V3 线索网站登录（可选，默认见 PRD）
# WEB_LOGIN_USER=Sylicora
# WEB_LOGIN_PASSWORD=JustGetItDone
# WEB_SECRET_KEY=请在生产环境设置随机密钥
# PORT=5050
